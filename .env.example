# ============================================================
# Audit-Skill-ZeroBaran — نسخة الأسرار (املأها ثم انسخها إلى .env)
# كل المفاتيح اختيارية: يعمل النظام بدونها بالمحرّك المدمج.
# ============================================================

# --- عقل التدقيق الذكي (أي واحد يكفي) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=gemini/gemini-2.0-flash

# --- سجلّ التدقيق (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=audit_reports

# --- التنبيه الفوري (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- سلوك الفحص ---
AUDIT_FAIL_ON=high
AUDIT_MAX_AI_FINDINGS=20
